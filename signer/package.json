{
  "name": "@hollow-vault/signer",
  "version": "1.0.0",
  "private": true,
  "description": "Edge signer service. Delegates Ethereum signing to SpaceComputer's Orbitport KMS — the private key never lives on this device.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=../.env dist/server.js"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@spacecomputer-io/orbitport-sdk-ts": "^0.2.1",
    "express": "^4.21.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3"
  }
}
