# ─────────────────────────────────────────────────────────────────────────────
# Hollow Vault — environment configuration
#
# Copy this file to `.env` and follow the REQUIRED steps below:
#   cp .env.example .env
#
# This project is designed to run against SpaceComputer's PRODUCTION Orbitport
# KMS + cTRNG. You must obtain real credentials before the signer will start.
# (A `mock` mode exists for offline development only — see the bottom of this
# file. The web UIs all assume real mode.)
# ─────────────────────────────────────────────────────────────────────────────

# Where the signer process listens; the web app calls this URL server-side.
SIGNER_URL=http://localhost:8080
SIGNER_PORT=8080

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED · Step 1: get production credentials from SpaceComputer
# ─────────────────────────────────────────────────────────────────────────────
#
#   1. Open https://accounts.spacecomputer.io/
#   2. Sign up / log in.
#   3. Generate an OAuth Client ID + Client Secret pair on the dashboard.
#   4. Paste them below.
#
# These are PRODUCTION credentials. Keep them server-side. Never expose as
# NEXT_PUBLIC_*. The .env file in this repo is gitignored.

ORBITPORT_CLIENT_ID=
ORBITPORT_CLIENT_SECRET=

# Real mode is the ONLY supported demo path. The signer refuses to start
# without credentials when this is set to `real`. Override to `mock` only for
# offline/CI work — the UIs will show a "mock — not for production demo" banner.
ORBITPORT_MODE=real

# ─────────────────────────────────────────────────────────────────────────────
# Endpoint pinning (rarely needs to change — defaults are correct for prod)
# ─────────────────────────────────────────────────────────────────────────────

ORBITPORT_API_URL=https://op.spacecomputer.io/api/v1/services/trng
ORBITPORT_AUTH_URL=https://auth.spacecomputer.io/oauth/token
ORBITPORT_AUDIENCE=https://op.spacecomputer.io/api

# Where the signer caches its identity. Defaults are fine; override if you
# want a different on-disk location.
#   KMS_KEY_CACHE_PATH=.runtime/kms-key.json
#   KEYSTORE_PATH=.runtime/local-key.json
